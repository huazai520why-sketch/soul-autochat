# ─────────────────────────────────────────────────────────────
# soul-autochat 配置模板
# 用法：复制成 config/model.env 再改（model.env 已被 gitignore，不会进仓库）
#   Windows:  copy config\model.env.example config\model.env
#   *nix:     cp config/model.env.example config/model.env
#
# 加载方式：run.py 启动时逐行读取，用 os.environ.setdefault 注入
#   → 已经存在的环境变量优先，这里只做「缺省值」
#   → 改完必须重启 daemon 才生效
# ─────────────────────────────────────────────────────────────

# ── 出话模型（OpenAI 兼容端点即可）─────────────────────────────
SOUL_ARK_URL_DIRECT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
SOUL_ARK_MODEL_DIRECT=deepseek-v4-1-flash-261017

# 密钥**不要**写在这里。
# 读取顺序：环境变量 SOUL_ARK_KEY → 项目根目录的 .ark_key 文件（一行，不加引号）
# 两个位置都在 .gitignore 里。

# ── 出话流程 ──────────────────────────────────────────────────
# direct = 直连模型出话（推荐，快）
# hybrid = 本地算方案 + 云端出话
# fc     = Function Calling 三轮（慢，需要工具链支持）
# legacy = 调用旧项目 soul_brain（**需要额外目录，开源版不支持**）
SOUL_FLOW=direct

# 单轮 Function Calling 总预算（秒）
SOUL_FC_BUDGET=55

# 画像来源：llm = 本地模型；data = 直接读库
SOUL_PORTRAIT=llm

# ── 提示词结构 ────────────────────────────────────────────────
# 1 = system 里放「人设 + 她的档案」，user 放她的原话（推荐）
# 0 = 旧结构
SOUL_PROMPT_V9=1

# ── 语气时段分层 ──────────────────────────────────────────────
# day     : NIGHT_END(5) ~ WARM_START(21)     禁一切暗示
# warm    : WARM_START(21) ~ TENSION_START    只许时间层 + 情绪层
# tension : TENSION_START ~ NIGHT_END(5)      允许暧昧/张力
#           但**依然禁露骨动作句**（gate._SOLICIT_RE 会直接作废整句）
SOUL_TENSION_START=23

# ── 你自己的联系方式（可选）───────────────────────────────────
# 源码里的默认值是国内示例号 13800138000，公开仓库不含任何真实号码。
# 想让它真的能用，在这里填你自己的（这行不会进 git）：
# SOUL_MY_CONTACT=13800138000

# ── 本地模型（分析 / 简报用，出话不走这里）────────────────────
# 出话只走上面的方舟通道；本机没有 Ollama 也能跑，只是简报会降级。
SOUL_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions
SOUL_OLLAMA_URL=http://127.0.0.1:11434/api/chat
SOUL_LOCAL_MODEL=qwen2.5:7b-instruct
SOUL_LOCAL_KEY=

# ── 节奏与阈值（一般不用改）───────────────────────────────────
# 空闲多少分钟后切号
SOUL_IDLE_SWITCH_MIN=30
# 两次重启 App 的最小间隔（秒）。太小会导致设备一直在冷启动，什么都判断不了
SOUL_RESTART_MIN_GAP=240
# 日发送配额上限 / 预警线
SOUL_CAP_H=200
SOUL_CAP_WARN=150
# 设备自愈三级开关（0 = 关掉最重的「重建模拟器」那级）
SOUL_DEV_RESCUE_L3=1

# ── 日志 ──────────────────────────────────────────────────────
# 日志按模块分文件写到 logs/，每条 flush，是排障的权威来源
# logs/ 不进仓库
